[Unit]
Description=Polybot Pump.fun — Paper Trading Only
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/crypto-trading-bot
ExecStart=/root/crypto-trading-bot/bot-env/bin/python3 -m polybot.main_pumpfun
Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1
Environment=PUMP_BUDGET=100
Environment=PUMP_POSITION_EUR=2
Environment=PUMP_MAX_OPEN_POSITIONS=1
Environment=PUMP_MIN_AGE_SEC=180
Environment=PUMP_MAX_AGE_SEC=2400
Environment=PUMP_MIN_MARKET_CAP_SOL=25
Environment=PUMP_MAX_MARKET_CAP_SOL=300
Environment=PUMP_MIN_CHANGE_PCT=6
Environment=PUMP_MAX_CHANGE_PCT=28
Environment=PUMP_MIN_PEAK_CHANGE_PCT=18
Environment=PUMP_MIN_PULLBACK_PCT=7
Environment=PUMP_MAX_PULLBACK_PCT=25
Environment=PUMP_MIN_TRADES=30
Environment=PUMP_MIN_UNIQUE_TRADERS=12
Environment=PUMP_MIN_RECENT_CHANGE_PCT=2
Environment=PUMP_MAX_RECENT_CHANGE_PCT=10
Environment=PUMP_MIN_BUY_SELL_RATIO=1.4
Environment=PUMP_RECENT_ACTIVITY_SEC=60
Environment=PUMP_MIN_RECENT_TRADES=6
Environment=PUMP_MIN_RECENT_BUY_SELL_RATIO=1.2
Environment=PUMP_ALLOW_MIGRATED_ENTRIES=false
Environment=PUMP_STOP_LOSS_PCT=12
Environment=PUMP_TAKE_PROFIT_PCT=20
Environment=PUMP_TRAILING_STOP_PCT=8
Environment=PUMP_TRAIL_FLOOR_PCT=5
Environment=PUMP_MAX_HOLD_SEC=1200
Environment=PUMP_SLIPPAGE_PCT=2.5
Environment=PUMP_PLATFORM_FEE_PCT=1
Environment=PUMP_PAPER_MODE=true

[Install]
WantedBy=multi-user.target
