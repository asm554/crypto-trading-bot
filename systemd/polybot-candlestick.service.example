[Unit]
Description=Polybot Candlestick (Der Kerzenreiter) — Paper Trading
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/crypto-trading-bot
ExecStart=/root/crypto-trading-bot/bot-env/bin/python3 -m polybot.main_candlestick
Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1
Environment=CND_BUDGET=500
Environment=CND_INTERVAL_SEC=60
Environment=CND_MIN_SCORE=75
Environment=CND_VOLUME_MULTIPLIER=1.3
Environment=CND_ATR_STOP_MULTIPLIER=2.0
Environment=CND_REWARD_RISK=1.8
Environment=CND_MAX_RISK_EUR=2.50
Environment=CND_MAX_POSITION_EUR=125
Environment=CND_MAX_PRICE_IMPACT_PCT=0.5
Environment=CND_SLIPPAGE_BPS=50
Environment=CND_MAX_HOLD_H=48
Environment=CND_LOSS_STREAK_LIMIT=3
Environment=CND_LOSS_PAUSE_H=24
Environment=CND_ACCOUNT_LOSS_LIMIT_PCT=10
Environment=CND_SNAPSHOT_MIN=15
Environment=CND_PAPER_MODE=true

[Install]
WantedBy=multi-user.target
