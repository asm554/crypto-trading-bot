[Unit]
Description=Polybot Futures Grid Signal (Treppensteiger Signal) — Paper Trading
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/crypto-trading-bot
ExecStart=/root/crypto-trading-bot/bot-env/bin/python3 -m polybot.main_futures_grid_signal
Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1
Environment=GRIDSIG_BUDGET=5000
Environment=GRIDSIG_LEVERAGE=2
Environment=GRIDSIG_ORDER_MARGIN_EUR=125
Environment=GRIDSIG_TAKE_PROFIT_PCT=1.2
Environment=GRIDSIG_MAX_SAFETY_ORDERS=7
Environment=GRIDSIG_MAINTENANCE_MARGIN_PCT=5
Environment=GRIDSIG_MARGIN_GUARD_RATIO=1.25
Environment=GRIDSIG_TAKER_FEE_RATE=0.0005
Environment=GRIDSIG_FUNDING_RATE_8H=0.0001
Environment=GRIDSIG_COOLDOWN_WIN_SEC=43200
Environment=GRIDSIG_COOLDOWN_LOSS_SEC=2592000
Environment=GRIDSIG_CRASH_PAUSE_SEC=86400
Environment=GRIDSIG_MIN_BUY_GAP_SEC=3600
Environment=GRIDSIG_HARD_STOP_PCT=7.5
Environment=GRIDSIG_CYCLE_LOSS_LIMIT_PCT=3
Environment=GRIDSIG_MIN_TREND_SPREAD_ATR=0.75
Environment=GRIDSIG_TRAILING_ACTIVATION_PCT=2
Environment=GRIDSIG_LOSS_TREND_EXIT_SEC=1209600
Environment=GRIDSIG_MAX_CYCLE_SEC=1814400
Environment=GRIDSIG_SIGNAL_REFRESH_SEC=300
Environment=GRIDSIG_SCAN_INTERVAL_SEC=60
Environment=GRIDSIG_PAPER_MODE=true

[Install]
WantedBy=multi-user.target
