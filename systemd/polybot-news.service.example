[Unit]
Description=Polybot News (Der Reporter) — Paper Trading
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/crypto-trading-bot
ExecStart=/root/crypto-trading-bot/bot-env/bin/python3 -m polybot.main_news
Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1
# TYPESAFE_API_KEY gehört in polybot/.env, nicht in diese Datei.
Environment=NEWS_BUDGET=500
Environment=NEWS_POLL_INTERVAL_SEC=60
Environment=NEWS_MAX_HEADLINE_AGE_SEC=900
Environment=NEWS_MIN_CHOICE_PROB=0.6
Environment=NEWS_MIN_BULLISH=0.70
Environment=NEWS_MIN_NEW=0.7
Environment=NEWS_MAX_BEARISH=0.3
Environment=NEWS_POSITION_EUR=25
Environment=NEWS_STOP_LOSS_PCT=1.5
Environment=NEWS_TRAILING_ACTIVATION_PCT=1.0
Environment=NEWS_TRAILING_STOP_PCT=1.0
Environment=NEWS_MAX_HOLD_H=2
Environment=NEWS_MAX_OPEN_POSITIONS=2
Environment=NEWS_MAX_TRADES_PER_DAY=6
Environment=NEWS_LOSS_STREAK_LIMIT=3
Environment=NEWS_LOSS_PAUSE_H=6
Environment=NEWS_ACCOUNT_LOSS_LIMIT_PCT=10.0
Environment=NEWS_PAPER_MODE=true

[Install]
WantedBy=multi-user.target
